# =============================================================================
# Copie para `.env` e ajuste conforme COMO voce sobe o ambiente (veja abaixo).
# =============================================================================

NODE_ENV=stage
PORT=3000

# --- Banco (Postgres local via docker-compose: porta 5457 no host) ---
DB_USER=agregamigos
DB_PASSWORD=initial123
DB_DATABASE=agregamigos
DB_HOST=127.0.0.1
DB_PORT=5457
DB_DIALECT=postgres

# --- Redis (fila BullMQ). Docker local expoe 6380 no host ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# REDIS_URL=redis://127.0.0.1:6380

# --- Worker de campanha ---
# O ritmo real e imposto por canal dentro da API; concorrencia alta aqui nao acelera.
CAMPANHA_ENVIO_CONCURRENCY=2
CAMPANHA_ENVIO_TENTATIVAS=5
CAMPANHA_ENVIO_BACKOFF_MS=5000
CAMPANHA_ENVIO_TIMEOUT_MS=240000

# Reagendamento de falhas transitorias (em minutos), em vez de queimar o destinatario
CAMPANHA_REAGENDAR_LIMITE_MIN=60
CAMPANHA_REAGENDAR_PAUSA_MIN=10
CAMPANHA_REAGENDAR_DESCONEXAO_MIN=5
CAMPANHA_REAGENDAR_PADRAO_MIN=2

# --- Protecao do numero WhatsApp (anti-bloqueio) ---
# Teto diario por numero. Use 0 para desativar e controlar o ritmo apenas
# pelo campo "Msgs/turno" de cada campanha.
WHATSAPP_LIMITE_DIARIO_MAX=200

# Intervalo entre dois envios do MESMO numero (sorteado nesta faixa).
WHATSAPP_INTERVALO_MIN_MS=25000
WHATSAPP_INTERVALO_MAX_MS=75000

# Simular "digitando..." antes de enviar.
WHATSAPP_SIMULAR_DIGITACAO=true
WHATSAPP_MS_POR_CARACTERE=55
WHATSAPP_DIGITACAO_MIN_MS=1800
WHATSAPP_DIGITACAO_MAX_MS=12000

# Botoes nativos por API nao oficial aumentam muito o risco de bloqueio.
# Desativado: as opcoes vao numeradas no corpo do texto.
WHATSAPP_PERMITIR_BOTOES_NATIVOS=false

# Disjuntor: apos N falhas consecutivas, o canal pausa por este tempo.
WHATSAPP_FALHAS_PARA_PAUSAR=5
WHATSAPP_PAUSA_PROTECAO_MS=1800000

# Fila de envio por canal: acima disto o worker reagenda em vez de esperar.
WHATSAPP_MAX_FILA_ENVIO=2

# Reconexao com recuo exponencial (evita loop agressivo).
WHATSAPP_MAX_TENTATIVAS_RECONEXAO=10
WHATSAPP_RECONEXAO_BASE_MS=5000
WHATSAPP_RECONEXAO_TETO_MS=300000

# Reconectar canais com sessao salva no arranque da API.
WHATSAPP_RESTAURAR_SESSOES=true

# Identificacao do cliente: macos | windows | ubuntu
WHATSAPP_NAVEGADOR=macos

# Cache de verificacao de numero (evita consultar onWhatsApp a cada envio).
WHATSAPP_TTL_CACHE_NUMERO_MS=604800000

JWT_SECRET=defina-um-segredo-local

# URL publica do site (HTTPS), usada na previa Open Graph ao compartilhar link de cadastro.
# PUBLIC_WEB_ORIGIN=https://seu-dominio.com.br

# --- Worker → API (/whatsapp/send-interno). Baileys so corre no processo da API ---
#
# DESENVOLVIMENTO (npm start na pasta agregamigos-api: API + worker no Windows/Mac):
#   NAO defina INTERNAL_API_URL, ou use:
#   INTERNAL_API_URL=http://127.0.0.1:3000/api
#   INTERNAL_API_KEY=dev-local-key
#
# DOCKER COMPOSE (servicos api + worker-campanha):
#   O worker-campanha ja recebe INTERNAL_API_URL=http://api:3000/api no compose.
#   Nao precisa repetir no .env da API; no worker em Docker nao use 127.0.0.1.
#
# PRODUCAO (Hostinger etc.):
#   INTERNAL_API_KEY com chave forte; mesma chave na API e no worker.
#
# INTERNAL_API_URL=http://127.0.0.1:3000/api
# INTERNAL_API_KEY=dev-local-key

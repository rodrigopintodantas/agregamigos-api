NODE_ENV=stage
# Porta interna da API (container)
PORT=3000

DB_USER=agregamigos
DB_PASSWORD=initial123
DB_DATABASE=agregamigos
DB_HOST=127.0.0.1
DB_PORT=5457
DB_DIALECT=postgres

# Redis para fila de envio (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Worker de campanha
CAMPANHA_ENVIO_CONCURRENCY=4
CAMPANHA_ENVIO_TENTATIVAS=5
CAMPANHA_ENVIO_BACKOFF_MS=5000

JWT_SECRET=
# Em Docker de producao, publicar a API na porta 4002 (ver docker-compose)
# JWT_EXPIRES_IN=7d

#!/usr/bin/env node

require("dotenv").config();

const http = require("http");
const app = require("../app");
const { sequelize } = require("../models");

const port = normalizePort(process.env.PORT || "3000");
app.set("port", port);

const server = http.createServer(app);

const MAX_DB_RETRIES = Number(process.env.DB_CONNECT_RETRIES || 10);
const DB_RETRY_DELAY_MS = Number(process.env.DB_CONNECT_RETRY_DELAY_MS || 2000);

process.on("unhandledRejection", (reason) => {
  console.error("Unhandled rejection:", reason);
});

process.on("uncaughtException", (error) => {
  console.error("Uncaught exception:", error);
});

async function startServer() {
  console.log(`[boot] Iniciando API na porta ${port}...`);
  console.log(`[boot] NODE_ENV=${process.env.NODE_ENV || "stage"}`);

  for (let attempt = 1; attempt <= MAX_DB_RETRIES; attempt += 1) {
    try {
      console.log(`[db] Tentando conectar (${attempt}/${MAX_DB_RETRIES})...`);
      await sequelize.authenticate();
      console.log("[db] Conexao com o banco estabelecida.");
      server.listen(port);
      server.on("error", onError);
      server.on("listening", onListening);
      return;
    } catch (err) {
      const isLastAttempt = attempt === MAX_DB_RETRIES;
      console.error(`[db] Falha ao conectar: ${err.message}`);
      if (isLastAttempt) {
        console.error("[db] Numero maximo de tentativas atingido. Encerrando processo.");
        process.exit(1);
      }
      await delay(DB_RETRY_DELAY_MS);
    }
  }
}

function normalizePort(val) {
  const parsedPort = parseInt(val, 10);
  if (Number.isNaN(parsedPort)) return val;
  if (parsedPort >= 0) return parsedPort;
  return false;
}

function delay(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

function onError(error) {
  if (error.syscall !== "listen") throw error;

  const bind = typeof port === "string" ? `Pipe ${port}` : `Port ${port}`;
  switch (error.code) {
    case "EACCES":
      console.error(`${bind} requires elevated privileges`);
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(`${bind} is already in use`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  const addr = server.address();
  const bind = typeof addr === "string" ? `pipe ${addr}` : `port ${addr.port}`;
  console.log(`Servidor iniciado em ${bind}`);
  try {
    require("../jobs/engajamento-sem-resposta-primeiro-contato").iniciarJobEngajamentoSemResposta();
  } catch (err) {
    console.error("[boot] Falha ao iniciar job de engajamento (sem resposta):", err?.message || err);
  }
  require("../services/whatsapp-baileys")
    .restaurarSessoesSalvas()
    .then(({ restaurados }) => {
      console.log(`[boot] Canais WhatsApp restaurados: ${restaurados}.`);
    })
    .catch((err) => {
      console.error("[boot] Falha ao restaurar canais WhatsApp:", err?.message || err);
    });
}

startServer();
